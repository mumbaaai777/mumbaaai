# Public path the app is served from. GitHub Pages project site: /<repo-name>/
VITE_BASE=/mumbaaai/

# Supabase (optional). Leave empty to run on bundled sample data.
# The anon key is public by design; Row Level Security protects writes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Worker URL (optional). Empty = Ask Aai shows "AI not connected yet", news uses samples.
VITE_API_URL=

# Radio stream (optional). Empty = Radio Paradise 128k MP3, labelled "Test stream".
VITE_RADIO_STREAM_URL=
VITE_RADIO_IS_TEST=true
